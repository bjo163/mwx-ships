# ==========================================
# MOONSHIPS ENVIRONMENT CONFIGURATION
# ==========================================

# Host publish address. Loopback remains the defense-in-depth default even with JWT auth.
MOONSHIPS_BIND_IP=127.0.0.1

# Server binding inside the container
PORT=5150
BINDING=0.0.0.0
HOST=http://localhost:5150
LOG_LEVEL=info

# SQLite Database & Persistent Queue (SQLite-First MVP)
DATABASE_URL=sqlite://data/moonships.sqlite?mode=rwc
QUEUE_URL=sqlite://data/moonships.sqlite?mode=rwc
DB_LOGGING=false
DB_CONNECT_TIMEOUT=500
DB_IDLE_TIMEOUT=500
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=1

# Secret Encryption (AES-256-GCM: 32 bytes hex-encoded, 64 hex chars)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=

# JWT Authentication
# Generate a strong random value; do not reuse ENCRYPTION_KEY.
JWT_SECRET=
JWT_EXPIRATION=604800

# Mailer (Optional; disabled by default)
MAILER_ENABLE=false
MAILER_HOST=localhost
MAILER_PORT=587
MAILER_SECURE=true
MAILER_USER=
MAILER_PASSWORD=


# Deployment reliability (v0.3)
# Lease prevents duplicate workers from executing the same deployment concurrently.
MOONSHIPS_DEPLOYMENT_LEASE_SECS=7200

# Keep at least this many newest revision images per application.
# current/previous known-good revisions are always protected regardless of this value.
MOONSHIPS_REVISION_ARTIFACT_RETENTION=10

# Delete deployment log rows older than this many days after successful deployments.
MOONSHIPS_DEPLOYMENT_LOG_RETENTION_DAYS=30

# Emit a cleanup warning when target disk free space drops below this threshold.
MOONSHIPS_DISK_WARNING_GB=2

# Managed ingress / TLS (v0.4)
# Moonships starts and manages this Traefik image on target servers when an app has
# one or more domains and no published host port.
MOONSHIPS_TRAEFIK_IMAGE=traefik:v3.1

# Required only when at least one managed domain has HTTPS enabled.
# Used for Let's Encrypt HTTP-01 registration.
MOONSHIPS_ACME_EMAIL=


# Git automation / preview deployments (v0.5)
# Required to create pull/merge-request preview hostnames, for example:
# preview-42-17.preview.example.com
MOONSHIPS_PREVIEW_BASE_DOMAIN=

# Enable HTTPS for generated preview domains. When true, managed ingress also
# requires MOONSHIPS_ACME_EMAIL and DNS that resolves preview hostnames to target servers.
MOONSHIPS_PREVIEW_HTTPS=false
